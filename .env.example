# Environment Variables - REQUIRED FOR PRODUCTION
# Copy this file to .env.local and fill in all values

# ===== CRITICAL - MUST SET =====

# JWT Secret for token signing (generate a random string for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars

# Database Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name

# API Base URL (for frontend to communicate with backend)
NEXT_PUBLIC_API_URL=https://api.manishsteel.com.np

# Cloudinary Configuration (for image storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ===== OPTIONAL =====

# Cloudinary API Secret (for server-side operations)
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Cloudinary folder for organizing images
NEXT_PUBLIC_CLOUDINARY_FOLDER=manish-steel

# Notification Service
TEXTMEBOT_API_KEY=your-textmebot-api-key
TEXTMEBOT_NOTIFICATION_PHONE=your-phone-number-for-notifications

# Node Environment
NODE_ENV=production

# ===== SECURITY NOTES =====
# 1. JWT_SECRET: Generate a strong random key, never commit it to git
# 2. MONGODB_URI: Keep credentials secure, use environment variables
# 3. CLOUDINARY credentials: Treat as sensitive, keep out of version control
# 4. All NEXT_PUBLIC_* variables are sent to the client, don't put secrets there
# 5. Never commit .env.local to git - add it to .gitignore
